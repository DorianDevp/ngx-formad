{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "examples": {
      "projectType": "application",
      "root": "projects/examples",
      "sourceRoot": "projects/examples/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/examples/src/main.ts",
            "index": "projects/examples/src/index.html",
            "tsConfig": "projects/examples/tsconfig.app.json",
            "styles": [
              "projects/examples/src/styles.css"
            ],
            "assets": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "examples:build:production"
            },
            "development": {
              "buildTarget": "examples:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "ngx-formad": {
      "projectType": "library",
      "root": "projects/ngx-formad",
      "sourceRoot": "projects/ngx-formad/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-formad/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-formad/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-formad/tsconfig.spec.json",
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    }
  }
}
