/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "paths": {
      "ngx-formad": ["./projects/ngx-formad/src/public-api.ts"],
      "ngx-formad/core": ["./projects/ngx-formad/core/src/public-api.ts"],
      "ngx-formad/template": ["./projects/ngx-formad/template/src/public-api.ts"],
      "ngx-formad/chrome": ["./projects/ngx-formad/chrome/src/public-api.ts"],
      "ngx-formad/tailwind": ["./projects/ngx-formad/tailwind/src/public-api.ts"],
      "ngx-formad/material": ["./projects/ngx-formad/material/src/public-api.ts"]
    },
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/ngx-formad/tsconfig.lib.json"
    },
    {
      "path": "./projects/ngx-formad/tsconfig.spec.json"
    }
  ]
}
